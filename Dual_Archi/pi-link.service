sudo tee /etc/systemd/system/pi-link.service > /dev/null << 'EOF'
[Unit]
Description=Greenhouse ESP32-S3 serial bridge (pi_link)
After=network.target
Wants=network.target

[Service]
Type=simple
User=crk
WorkingDirectory=/home/crk/THESIS/Dual_Archi
ExecStart=/usr/bin/python3 /home/crk/THESIS/Dual_Archi/pi_link.py
Restart=always
RestartSec=10
StandardOutput=append:/home/crk/THESIS/Dual_Archi/pi_link.log
StandardError=append:/home/crk/THESIS/Dual_Archi/pi_link.log

[Install]
WantedBy=multi-user.target
EOF