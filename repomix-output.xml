<script>
const $=id=>document.getElementById(id);
let S=null;
(function(){let h='';for(let i=0;i<9;i++)h+=
'<div class="card pod"><div class="ph"><b>P-0'+(i+1)+'</b><span id="sm'+i+'">--</span></div>'+
