// (= container capacity, NOT 100 % VWC). So this reports PERCENT OF CONTAINER
// CAPACITY. Multiply by CC/100 offline to get true VWC.
int dryADC[NUM_PODS] = {2553, 2553, 2553, 2553, 2553, 2553, 2553, 2553, 2553};
